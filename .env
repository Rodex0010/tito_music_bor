# ==============================================================================
# FEATURE FLAGS (Optional)
# ==============================================================================

# QUEUE_END_MESSAGE: Automatically end stream when queue finishes (True/False)
# QUEUE_END_MESSAGE=False

# AUTO_LEAVE: Assistant auto-leaves empty voice chat after 20 mins (True/False)
# AUTO_LEAVE=False

# THUMB_GEN: Generate custom thumbnails for now playing (True/False)
# THUMB_GEN=True

# VIDEO_PLAY: Enable /vplay commands for streaming video in VC (True/False)
# VIDEO_PLAY=True

# VIDEO_MAX_HEIGHT: Resolution for /vplay download AND playback (360-1080)
# Lower = less CPU. Recommended: 480 for 100+ groups, 720 for small bots
# VIDEO_MAX_HEIGHT=480

# ==============================================================================
# MODERATION (Optional)
# ==============================================================================

# EXCLUDED_USERNAMES: Space-separated list of usernames to exclude from admin mentions
# EXCLUDED_USERNAMES=User1 User2 User3
